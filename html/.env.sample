APP_NAME=your_app_name
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=your_app_url

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=your_hostname
DB_PORT=your_port
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Gemini (뉴스 스크랩 AI 분석 / 챗봇 / 이미지 생성)
GEMINI_API_KEY=
# 뉴스 스크랩 AI 분석 모델. 구조화 출력과 url_context 도구를 지원하는 모델이어야 한다.
GEMINI_API_MODEL=gemini-3.7-flash

# Firebase Cloud Messaging (앱 푸시)
# 서비스 계정 키 파일은 git 에 올리지 않고 서버마다 이 경로에 둔다 (html 기준 상대 경로)
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
# 웹 SDK 공개 설정값 (Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# 웹 푸시 인증서 공개 키 (Firebase 콘솔 > 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서)
FIREBASE_VAPID_KEY=
# 외부 프로그램이 /api/push/send 를 호출할 때 X-Push-Key 헤더로 보내는 공유 키 (비우면 발송 API 거절)
PUSH_API_KEY=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
